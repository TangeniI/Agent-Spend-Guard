{
  "name": "agent-spend-guard",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "turbo run db:migrate",
    "concurrency": "node --env-file-if-exists=.env scripts/concurrency.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "e2e": "node --env-file-if-exists=.env scripts/e2e-purchase.ts"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "tslib": "2.8.1"
    }
  }
}
