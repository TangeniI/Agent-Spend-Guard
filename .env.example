# Local Docker Postgres from docker-compose.yml. These are not secrets.
DATABASE_URL=postgres://asg:asg@localhost:5433/asg
# Tests create and drop their own databases, so this user needs CREATEDB.
TEST_ADMIN_DATABASE_URL=postgres://asg:asg@localhost:5433/postgres
PORT=3001
# Bearer token for every API route except /health. Generate your own, even locally.
API_SERVICE_TOKEN=change-me
# Where scripts/concurrency.ts finds the running API.
API_URL=http://localhost:3001
# Where the mock shop listens, and where the agent and scripts find it.
SHOP_PORT=3002
SHOP_URL=http://localhost:3002
# Needed only for live agent runs. Tests and CI use a scripted model instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
